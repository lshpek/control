APP_NAME=BOTVEX Control Center
APP_VERSION=0.1.0
DEBUG=true
LOCAL_DEV_MODE=true
BIND_HOST=127.0.0.1
DATABASE_URL=sqlite:///./backend/botvex.db
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Bot token from @botvexdev_bot. Keep the real token only in local .env.
TELEGRAM_BOT_TOKEN=
# Numeric ID of your Telegram user or alert group (not the bot username).
TELEGRAM_ALERT_CHAT_ID=
SERVICE_MONITOR_ENABLED=true
SERVICE_MONITOR_POLL_SECONDS=30
SERVICE_MONITOR_TIMEOUT_SECONDS=5
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
SESSION_COOKIE_NAME=botvex_session
SESSION_TTL_SECONDS=28800
LOGIN_WINDOW_SECONDS=900
LOGIN_MAX_PER_IDENTITY=5
LOGIN_MAX_PER_IP=20
BOOTSTRAP_OWNER_USERNAME=lshpek
BOOTSTRAP_OWNER_PASSWORD=
